&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#a6e22e"&gt;add&lt;/span&gt; &lt;span style="color:#66d9ef"&gt;w0&lt;/span&gt;, &lt;span style="color:#66d9ef"&gt;w0&lt;/span&gt;, &lt;span style="color:#75715e"&gt;#1
